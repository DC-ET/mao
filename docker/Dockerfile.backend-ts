FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY backend-ts/package.json backend-ts/package-lock.json backend-ts/
RUN cd backend-ts && npm ci
COPY backend-ts backend-ts
RUN cd backend-ts && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /build/backend-ts/package.json /build/backend-ts/package-lock.json ./
COPY --from=build /build/backend-ts/node_modules ./node_modules
COPY --from=build /build/backend-ts/dist ./dist
COPY --from=build /build/backend-ts/config ./config
COPY --from=build /build/backend-ts/db ./db
COPY backend-ts/restart.sh ./restart.sh
RUN chmod +x ./restart.sh \
    && mkdir -p /opt/mao/data/workspace /opt/mao/data/skills /opt/mao/data/userskills /opt/mao/data/uploads /opt/mao/data/runtime
VOLUME ["/opt/mao/data"]
EXPOSE 9081
ENV NODE_ENV=production
CMD ["node", "dist/main.js"]
