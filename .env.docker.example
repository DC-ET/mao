# 复制为 .env 后供 docker compose 使用（可选，不复制则使用下方默认值）
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=mao
MYSQL_PASSWORD=mao123
# 后端为 TypeScript（NestJS + Fastify），监听 9080；连接串主机为 mysql 服务名
MYSQL_URL=jdbc:mysql://mysql:3306/mao?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&allowMultiQueries=true
JWT_SECRET=please-change-me-in-production
APP_GIT_CREDENTIAL_SECRET=please-change-me-in-production
APP_NOTIFICATION_WEBHOOK_SECRET=please-change-me-in-production
UPLOAD_BASE_URL=http://localhost:5201/api
