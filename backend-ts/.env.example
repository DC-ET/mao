# TypeScript backend environment template — copy to backend-ts/.env and edit.
# 复制为 backend-ts/.env 后编辑（.env 已被 gitignore，不会入库）。

# 端口（默认 9080，Java 版后端移除后由 TS 后端接管）
MAO_TS_PORT=9080
# 数据根目录
MAO_ROOT_DIR=/opt/mao
MAO_LOG_DIR=/opt/mao/backend-ts/logs
# 蓝绿部署摘流等待秒数（切换 Nginx 后延迟停止旧实例，默认 60）
# MAO_BLUE_GREEN_DRAIN_SEC=60
# 是否在启动时执行 Flyway 数据库迁移（默认 true）
FLYWAY_ENABLED=true

# MySQL（jdbc 连接串由 mysql2 解析；allowMultiQueries=true 供脚本迁移使用）
MYSQL_URL='jdbc:mysql://127.0.0.1:3306/mao?useSSL=false&serverTimezone=Asia/Shanghai&allowMultiQueries=true&zeroDateTimeBehavior=convertToNull&useUnicode=true&characterEncoding=utf-8'
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# 安全密钥（生产必设）
JWT_SECRET=change-me
JWT_SHELL_EXPIRATION=7200000
APP_GIT_CREDENTIAL_SECRET=change-me
APP_NOTIFICATION_WEBHOOK_SECRET=change-me
APP_MCP_SECRET=change-me

# 可选认证：LDAP / 飞书 SSO
LDAP_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=admin@example.com
LDAP_PASSWORD=123456
LDAP_USER_SEARCH_BASE=ou=Example

FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:9080/api/v1/auth/feishu/callback

# 上传与存储
UPLOAD_STORAGE_MODE=local
UPLOAD_BASE_URL=http://localhost:5201/api
FILE_UPLOAD_DIR=/opt/mao-data/uploads
WORKSPACE_ROOT=/opt/mao-data/workspace
MAO_RUNTIME_DIR=/opt/mao-data/runtime
MAO_USER_HOME_DIR=/opt/mao-data/users
SKILLS_DIR=/opt/mao-data/skills
USER_SKILLS_DIR=/opt/mao-data/userskills

# Agent 运行参数
MAX_CONCURRENT_AGENTS=100
AGENT_THREAD_POOL_SIZE=20
AGENT_THREAD_POOL_MAX=100
AGENT_THREAD_POOL_QUEUE=200
DEFAULT_MAX_ROUNDS=10
DEFAULT_CONTEXT_ROUNDS=20
APP_WS_IDLE_TIMEOUT_MS=90000

# 任务通知
TASK_NOTIFICATION_WORKER_DELAY_MS=30000
TASK_NOTIFICATION_BATCH_SIZE=100
TASK_NOTIFICATION_MAX_ATTEMPTS=4

# Tavily 搜索（可选）
TAVILY_API_KEY=

# 阿里云 OSS（可选；UPLOAD_STORAGE_MODE=oss 时必设）
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_STS_REGION_ID=
OSS_STS_ENDPOINT=
OSS_STS_ACCESS_KEY_ID=
OSS_STS_ACCESS_KEY_SECRET=
OSS_STS_ROLE_ARN=
OSS_STS_ROLE_SESSION_NAME=mao-sts

# 微信 Bot 通道（可选）
WEIXIN_BOT_ENABLED=true
