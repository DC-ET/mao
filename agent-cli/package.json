{
  "name": "mao-agent",
  "version": "0.1.2",
  "description": "mao-agent — 无 GUI 终端对话式 Agent 客户端（CLOUD / LOCAL）",
  "bin": {
    "mao-agent": "bin/mao-agent.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node scripts/prepare.cjs",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:shell": "cp ../desktop/electron/localShell.cjs vendor/localShell.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "dist/",
    "vendor/localShell.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DC-ET/mao.git",
    "directory": "agent-cli"
  },
  "homepage": "https://github.com/DC-ET/mao/tree/main/agent-cli",
  "bugs": {
    "url": "https://github.com/DC-ET/mao/issues"
  },
  "keywords": [
    "mao",
    "agent",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^3.2.0",
    "react": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
